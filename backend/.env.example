# ==========================================
# Faisal Hospital AI Receptionist Configuration
# ==========================================

PORT=8787
BUSINESS_TIMEZONE=Asia/Karachi
DATA_DIR=./data

# ------------------------------------------
# Security & Authentication
# ------------------------------------------
JWT_SECRET=faisal_receptionist_super_secret_jwt_key_2026_change_in_prod
ADMIN_EMAIL=admin@faisalhospital.pk
ADMIN_DEFAULT_PASSWORD=Admin@Faisal2026

# ------------------------------------------
# LLM Intelligence (Optional)
# If provided, the system uses natural conversation & tool calling.
# If omitted, it runs on the smart local deterministic hospital engine.
# ------------------------------------------

# Option 1: OpenAI (Default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 2: OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_MODEL=openai/gpt-4o-mini

# Option 3: Groq (Ultra-fast, free tier available at console.groq.com)
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Option 4: Google Gemini (Free tier available at aistudio.google.com)
# OPENAI_API_KEY=AIzaSy...
# OPENAI_MODEL=gemini-1.5-flash
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------
# Realistic Human Voice (TTS)
# "edge" = Free Microsoft Natural Neural Voice (Jenny / Uzma, zero-cost, human quality)
# "openai" = OpenAI Speech API (tts-1 with warm female voice 'nova')
# ------------------------------------------
TTS_PROVIDER=edge
